<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.ruixue.sdk.demo.leidian">

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:icon="@drawable/app_default_icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/app_default_icon"
        android:supportsRtl="true"
        android:theme="@style/ThemeTranslucent"
        tools:replace="android:allowBackup">
        <activity
            android:name="com.ruixue.sdk.demo.leidian.LeidianDemoActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="GAME_ID"
            android:value="1835" />
        <meta-data
            android:name="CHANNEL_ID"
            android:value="100000" />
        <meta-data
            android:name="SUN_CHANNEL_ID"
            android:value="100543" />

    </application>
</manifest>