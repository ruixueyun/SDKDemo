<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />


    <application android:name="com.ruixue.sdk.overseas.demo.MyApplication"
        android:allowBackup="true"
        android:icon="@drawable/app_default_icon"
        android:roundIcon="@drawable/app_default_icon"
        android:label="@string/app_name"

        android:supportsRtl="true"
        android:theme="@style/ThemeTranslucent">

        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="@string/facebook_app_id" />
        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="@string/facebook_client_token" />
        <!-- zalo -->
        <meta-data
            android:name="com.zing.zalo.zalosdk.appID"
            android:value="@string/zalo_app_id" />
         <!-- tiktok -->
        <meta-data
            android:name="com.ruixue.sdk.tiktok.clientKey"
            android:value="sbaw1k7xydgqyrrd2o" />
        <meta-data
            android:name="com.ruixue.sdk.tiktok.auth.scheme"
            android:value="ruixue://sdkresponse" />

        <activity
            android:name="com.zing.zalo.zalosdk.oauth.BrowserLoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- zalo- + app id -->
                <data android:scheme="zalo-1290303975374472026" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.ruixue.sdk.tiktok.AuthResultActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="sdkresponse"
                    android:scheme="ruixue" />
            </intent-filter>
        </activity> <!-- instagram -->
        <meta-data
            android:name="com.ruixue.sdk.instagram.clientId"
            android:value="@string/instagram_client_id" />
        <meta-data
            android:name="com.ruixue.sdk.instagram.redirectUrl"
            android:value="https://ruixue.com/instagram/oauth2" /> <!-- snapchat -->
        <meta-data
            android:name="com.snap.kit.clientId"
            android:value="817a23af-8d9c-4707-bb2c-1965d15e37fa" />
        <meta-data
            android:name="com.snap.kit.redirectUrl"
            android:value="qiye://rxloginresp/oauth2" />

        <activity
            android:name="com.snap.corekit.SnapKitActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!--
                    Enter the parts of your redirect url below
                    e.g., if your redirect url is myapp://snap-kit/oauth2
                        android:scheme="myapp"
                        android:host="snap-kit"
                        android:path="oauth2"
                !
                -->
                <data
                    android:host="rxloginresp"
                    android:path="/oauth2"
                    android:scheme="qiye" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.ruixue.sdk.demo.activity.SettingActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/ThemeTranslucent" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />

                <!-- 快手协议部分 使用方自行按照文档配置 https://doc.ruixuecloud.com/main/dev_doc/tripartite/kuaishou/clientAccess.html#%E9%85%8D%E7%BD%AE%E8%AF%B4%E6%98%8E -->
                <!-- <data -->
                <!-- android:host="home" -->
                <!-- android:scheme="ks+游戏缩写" /> -->
                <!-- 模拟配置通知栏点击事件的跳转地址 -->
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="jixiang433" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.ruixue.sdk.overseas.demo.OverseasShareTestActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

    </application>

</manifest>